APP_NAME=RankForge
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH__php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://rankforge.io

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
# -- OR use MySQL on production --
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rankforge
# DB_USERNAME=rankforge_user
# DB_PASSWORD=STRONG_PASSWORD_HERE

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=sync
